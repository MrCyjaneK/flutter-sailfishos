+double SnapDevicePixelRatio(double dpi) {
+  if (dpi <= 0.0) {
+    return 0.0;
+  }
+  double dpr = std::round(dpi / 160.0 * 4.0) / 4.0;
+  if (dpr < 1.0) {
+    dpr = 1.0;
+  } else if (dpr > 4.0) {
+    dpr = 4.0;
+  }
+  return dpr;
+}
+
+double ReadDconfDouble(const char* key) {
+  char cmd[256];
+  std::snprintf(cmd, sizeof(cmd), "dconf read %s 2>/dev/null", key);
+  FILE* pipe = popen(cmd, "r");
+  if (!pipe) {
+    return 0.0;
+  }
+  char buf[128] = {};
+  if (!std::fgets(buf, sizeof(buf), pipe)) {
+    pclose(pipe);
+    return 0.0;
+  }
+  pclose(pipe);
+  char stripped[128] = {};
+  size_t j = 0;
+  for (size_t i = 0; buf[i] != '\0' && j + 1 < sizeof(stripped); ++i) {
+    const char c = buf[i];
+    if (c != '\'' && c != '"' && c != ' ' && c != '\n' && c != '\r' &&
+        c != '\t') {
+      stripped[j++] = c;
+    }
+  }
+  return std::atof(stripped);
+}
+
+double ReadDevicePixelRatio() {
+  if (const char* env = std::getenv("FLUTTER_SCALE")) {
+    const double value = std::atof(env);
+    if (value > 0.0) {
+      return value;
+    }
+  }
+  return SnapDevicePixelRatio(
+      ReadDconfDouble("/lipstick/screen/primary/physicalDotsPerInch"));
+}
